# Copy to backend/.env (git-ignored) and fill in for a compatible plain-text chat endpoint.
KNV_LLM_BASE_URL=https://your-provider.example/v1
KNV_LLM_API_KEY=
KNV_LLM_MODEL=
# provider-default sends no thinking extension. For DeepSeek tool calls, use disabled:
# its default thinking mode requires reasoning history not retained by this adapter.
# Only use disabled with endpoints that accept thinking.type=disabled.
KNV_LLM_THINKING=provider-default
# Exact, case-sensitive modes: hash (offline) or bge-m3 (requires the ml extra).
# Invalid modes fail validation; changing model settings requires a process restart.
KNV_ENCODER=bge-m3
# Maximum bytes in one uploaded file (20 MiB); must be positive.
KNV_UPLOAD_MAX_BYTES=20971520
# Maximum Unicode code points in one newly submitted chat question.
KNV_CHAT_MAX_CHARS=4000

# Optional local reranking. Keep off until measured on your corpus/model.
# Exact modes: off or bge; bge requires a nonblank KNV_RERANK_MODEL.
KNV_RERANK=off
KNV_RERANK_MODEL=BAAI/bge-reranker-v2-m3
KNV_RERANK_THRESHOLD=0.60
