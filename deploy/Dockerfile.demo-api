FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONPATH=/app/backend/src \
    PATH="/app/backend/.venv/bin:$PATH"
WORKDIR /app/backend
RUN pip install --no-cache-dir uv==0.12.13
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY backend/src ./src
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY backend/dev/mock_server.py ./dev/mock_server.py
COPY backend/tests/fakes.py ./tests/fakes.py
COPY data/demo /app/data/demo
RUN useradd --create-home --uid 10001 knoventra
USER knoventra
EXPOSE 8000
# Seed documents, then the fictional field journals (skill matrix + deduplicated cases, published
# to field-cases). A restart with the same journal bytes skips the import; its report goes to the
# container log. The ES index is derived from PostgreSQL: rebuild it last when ES is configured.
CMD ["sh", "-ec", "python -m alembic upgrade head\npython -m knoventra.db.seed\npython -m knoventra.ingestion.journal /app/data/demo/journals/journals-CN.xlsx /app/data/demo/journals/journals-SG.xlsx /app/data/demo/journals/journals-TW.xlsx --registry /app/data/demo/journals/machines.json --publish-kb field-cases --skip-if-imported\nif [ -n \"$KNV_ES_URL\" ]; then python -m knoventra.search_es.sync rebuild; fi\nexec python -m uvicorn mock_server:app --app-dir /app/backend/dev --host 0.0.0.0 --port 8000"]
